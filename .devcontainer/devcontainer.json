{
  "name": "Playbook 08: multimodal MLOps",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && pip install --no-cache-dir uv==0.13.0",
  "postCreateCommand": "make setup-uv",
  "forwardPorts": [8000, 8501, 5000],
  "portsAttributes": {
    "8000": { "label": "Model API" },
    "8501": { "label": "Monitoring dashboard" },
    "5000": { "label": "MLflow UI" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
